# Which deployment to run the suite against.
API_BASE_URL=http://localhost:3000

# Dedicated account the suite logs in as for all authenticated tests. It must
# already exist on the target environment — the suite never signs it up.
API_AUTOMATION_USERNAME=API_AUTOMATION
API_AUTOMATION_EMAIL=api.automation@example.com
API_AUTOMATION_PASSWORD=ApiAutomation123!
API_AUTOMATION_DISPLAY_NAME=API Automation

# Account used by tests/admin/* and tests/auth/signup.spec.ts. It must already
# exist AND its email must be listed in the app's own ADMIN_EMAILS for that
# environment, or the login succeeds but every admin call comes back 403.
#
# Unset is a valid way to run: those tests skip rather than fail, since an
# environment without a known admin isn't a bug in the app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
