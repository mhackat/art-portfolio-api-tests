# Which deployment to run the suite against.
API_BASE_URL=http://localhost:3000

# Dedicated account the suite logs in as for all authenticated tests. The setup
# project signs this account up if it doesn't exist yet (safe to reuse across runs).
API_AUTOMATION_USERNAME=API_AUTOMATION
API_AUTOMATION_EMAIL=api.automation@example.com
API_AUTOMATION_PASSWORD=ApiAutomation123!
API_AUTOMATION_DISPLAY_NAME=API Automation

# Optional. Only needed to run the admin test suite (tests/admin/*) — if unset,
# those tests are skipped rather than failed, since not every environment has a
# known admin account available to CI.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
